%% ===== STUDENT - REGISTRATION & LOGIN SEQUENCE =====
sequenceDiagram
  participant StudentUI as "Student Web UI"
  participant Mirror as "Mirror Kiosk UI"
  participant Backend as "Flask Backend (Auth & LEndpoints)"
  participant DB as "MySQL: students table"
  participant LSM as "Library Session Manager"
  participant Notif as "Notification Service"
  participant Audit as "audit_log / activity_log"

  Note over StudentUI: Student registers on main site
  StudentUI->>Backend: POST /api/students/register {payload}
  note right of StudentUI: payload includes personal info + contact
  Backend->>DB: CALL sp_register_student(payload)
  alt success
    DB-->>Backend: {studentId}
    Backend->>Audit: write 'student_registered'
    Backend-->>StudentUI: 201 {studentId, message}
  else duplicate/validation failure
    Backend-->>StudentUI: 400 {error: 'already_exists' | 'invalid'}
  end

  Note over StudentUI: Student login (manual)
  StudentUI->>Backend: POST /api/login {id, password}
  Backend->>DB: SELECT student WHERE id=:id
  alt found & password ok
    Backend->>LSM: create library_session (action_count odd)
    LSM-->>Backend: {sessionId}
    Backend->>Notif: create login notification
    Backend->>Audit: log 'user_login'
    Backend-->>StudentUI: 200 {sessionId}
  else invalid
    Backend-->>StudentUI: 401
  end

  Note over Mirror: QR login flow
  Mirror->>Backend: POST /api/library/login {qrData}
  Backend->>DB: validate QR -> SELECT student OR admin
  alt user valid
    Backend->>LSM: create_login_session
    LSM-->>Backend: {sessionId}
    Backend->>Notif: send session notification
    Backend-->>Mirror: 200 {sessionId}
  else invalid/expired QR
    Backend-->>Mirror: 401/400 error
  end

%% ===== STUDENT - RESERVE → BORROW → RETURN (DETAILED SEQUENCE) =====
sequenceDiagram
  participant StudentUI as "Student UI / Mirror"
  participant Backend as "Flask Backend / LEndpoints"
  participant DB as "MySQL: books, reservations, borrow_records"
  participant Notif as "Notification Service / Socket.IO"
  participant Audit as "audit_log"

  Note over StudentUI: Reserve book from main UI
  StudentUI->>Backend: POST /api/library/reserve-book {userId, bookId}
  Backend->>DB: SELECT books.available_copies WHERE id=bookId
  alt available >=1
    Backend->>DB: INSERT INTO reservations (userId,bookId,status='pending',created_at=NOW())
    Backend->>DB: UPDATE books SET available_copies = available_copies - 1 WHERE id=bookId
    Backend->>Notif: create reservation notification
    Backend->>Audit: insert 'reserve_book'
    Backend-->>StudentUI: 200 {reserved:true}
  else none
    Backend-->>StudentUI: 400 {error:'unavailable'}
  end

  Note over Mirror: Borrow at Mirror after user login
  Mirror->>Backend: POST /api/library/borrow-book {userId, bookId, sessionId}
  Backend->>DB: SELECT reservation WHERE userId=&bookId AND status='pending' ORDER BY created_at LIMIT 1
  alt reservation exists
    Backend->>DB: UPDATE reservation status='fulfilled'
  end
  Backend->>DB: INSERT INTO borrow_records (userId, bookId, borrowed_at, due_date)
  Backend->>DB: UPDATE books SET available_copies = available_copies - 1 WHERE id=bookId
  Backend->>Notif: emit borrow notification
  Backend->>Audit: insert 'borrow_book'
  Backend-->>Mirror: 200 {borrowId}

  Note over Mirror: Return at Mirror
  Mirror->>Backend: POST /api/library/return-book {userId, bookId, sessionId}
  Backend->>DB: SELECT borrow_records WHERE userId & bookId & status='borrowed' ORDER BY borrowed_at DESC LIMIT 1
  alt found
    Backend->>DB: UPDATE borrow_records SET status='returned', returned_at=NOW() WHERE id=borrowId
    Backend->>DB: UPDATE books SET available_copies = available_copies + 1 WHERE id=bookId
    Backend->>DB: compute overdue fines and write to fines table (if overdue)
    Backend->>Notif: notify user & admins
    Backend->>Audit: insert 'return_book'
    Backend-->>Mirror: 200 {returned:true}
  else not found
    Backend-->>Mirror: 404 {error:'no active borrow'}
  end

