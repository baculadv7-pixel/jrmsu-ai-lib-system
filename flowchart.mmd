  %% ===== ADMIN - BOOK MANAGEMENT (DETAILED SEQUENCE) =====
  sequenceDiagram
    participant AdminUI as "Admin UI (Book Mgmt)"
    participant Backend as "Flask Backend / LEndpoints"
    participant DB as "MySQL: books table / db_procs"
    participant Notif as "Notification Service"
    participant Audit as "Audit Logger"

    Note over AdminUI: Admin opens Book Management → Create Book form
    AdminUI->>Backend: POST /api/books
    note right of AdminUI: payload: { title, author, isbn, copies, category, shelf }
    Backend->>DB: INSERT INTO books (title, author, ...) VALUES (...)
    alt DB success
      DB-->>Backend: {insertId: 123}
      Backend->>Notif: create notification {type:'system', title:'Book added', audience:'admins'}
      Backend->>Audit: insert activity_log {actor:adminId, action:'book.create', bookId:123}
      Backend-->>AdminUI: 201 {bookId:123, message:'created'}
    else DB failure
      DB-->>Backend: error
      Backend->>Audit: insert activity_log {actor:adminId, action:'book.create.failed', error}
      Backend-->>AdminUI: 500 {error:'db error'}
    end

    Note over AdminUI: Admin updates book
    AdminUI->>Backend: PUT /api/books/:id
    note right of AdminUI: payload: { available_copies, status, metadata }
    Backend->>DB: UPDATE books SET ... WHERE id=:id
    alt DB success
      Backend->>Notif: generate 'book.updated' notification
      Backend->>Audit: insert activity_log {action:'book.update', bookId}
      Backend-->>AdminUI: 200 {updated:true}
    else
      Backend->>Audit: log update_failed
      Backend-->>AdminUI: 500
    end

    Note over AdminUI: Admin deletes a book
    AdminUI->>Backend: DELETE /api/books/:id
    Backend->>DB: DELETE FROM books WHERE id=:id
    alt deleted
      Backend->>Audit: insert activity_log {action:'book.delete', bookId}
      Backend->>Notif: emit 'book.removed'
      Backend-->>AdminUI: 200 {deleted:true}
    else not found
      Backend-->>AdminUI: 404 {message:'not found'}
    end

  %% ===== ADMIN - SESSION MONITOR (DETAILED SEQUENCE) =====
  sequenceDiagram
    participant AdminUI as "Admin Dashboard (Sessions)"
    participant Backend as "Flask Backend / LSessionMgr"
    participant DB as "MySQL: library_sessions"
    participant Socket as "Socket.IO"
    participant Audit as "audit_log"

    Note over AdminUI: Admin opens Active Sessions panel
    AdminUI->>Backend: GET /api/library/active-sessions
    Backend->>DB: SELECT * FROM library_sessions WHERE status='active'
    DB-->>Backend: [ {sessionId, userId, action_count, last_activity}, ... ]
    Backend-->>AdminUI: 200 {sessions: [...]}

    Note over AdminUI: Admin forces a logout for a user
    AdminUI->>Backend: POST /api/library/force-logout { userId }
    Backend->>DB: UPDATE library_sessions SET status='logged_out', action_count=action_count+1 WHERE userId=:userId AND status='active'
    alt update success
      DB-->>Backend: {affectedRows:1}
      Backend->>Socket: emit 'session_update' {userId, status:'logged_out'}
      Backend->>Audit: insert activity_log {actor:adminId, action:'force_logout', userId}
      Backend-->>AdminUI: 200 {ok:true}
    else
      Backend->>Audit: insert activity_log {actor:adminId, action:'force_logout_failed', userId}
      Backend-->>AdminUI: 404 {message:'no active session'}
    end

    Note over Socket,AdminUI: Real-time update
    Socket->>AdminUI: 'session_update' event — UI removes session or marks logged_out

